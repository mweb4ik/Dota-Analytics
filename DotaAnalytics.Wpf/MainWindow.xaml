<Window x:Class="DotaAnalytics.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dota Analytics"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="1000"
        Background="#101114">

    <Grid>

        <!-- Левая панель -->
        <Grid Width="220"
              HorizontalAlignment="Left"
              Background="#181A1F">

            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Логотип -->
            <TextBlock Text="DOTA ANALYTICS"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <!-- Навигация -->
            <StackPanel Grid.Row="1"
                        Margin="15,20">

				<Button Content="Matches"
						Height="45"
						Margin="0,0,0,8"
						Click="Matches_Click"/>

				<Button Content="Players"
						Height="45"
						Margin="0,0,0,8"
						Click="Players_Click"/>

				<Button Content="Heroes"
						Height="45"
						Margin="0,0,0,8"
						Click="Heroes_Click"/>

				<Button Content="Leaderboard"
						Height="45"
						Margin="0,0,0,8"
						Click="Leaderboard_Click"/>

            </StackPanel>

            <!-- Settings -->
            <Button Grid.Row="2"
                    Content="Settings"
                    Margin="15,10"/>

        </Grid>

        <!-- Основной контент -->
        <Grid Margin="220,0,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="Dashboard"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="35,0"/>

			<!-- Контент -->
			<Grid Grid.Row="1"
				  Margin="35"
				  x:Name="ContentArea">

				<StackPanel>

					<TextBlock Text="Welcome back."
							   Foreground="#A0A3AA"
							   FontSize="16"
							   Margin="0,0,0,25"/>

					<!-- Карточки -->
					<Grid>

						<Grid.ColumnDefinitions>
							<ColumnDefinition/>
							<ColumnDefinition/>
							<ColumnDefinition/>
						</Grid.ColumnDefinitions>

						<!-- Matches -->
						<Border Grid.Column="0"
								Background="#1B1E24"
								CornerRadius="10"
								Margin="0,0,15,0"
								Padding="20">

							<StackPanel>

								<TextBlock Text="MATCHES"
										   Foreground="#8D929B"
										   FontSize="12"/>

								<TextBlock Text="35"
										   Foreground="White"
										   FontSize="32"
										   FontWeight="Bold"
										   Margin="0,8,0,0"/>

							</StackPanel>

						</Border>

						<!-- Players -->
						<Border Grid.Column="1"
								Background="#1B1E24"
								CornerRadius="10"
								Margin="0,0,15,0"
								Padding="20">

							<StackPanel>

								<TextBlock Text="PLAYERS"
										   Foreground="#8D929B"
										   FontSize="12"/>

								<TextBlock Text="10"
										   Foreground="White"
										   FontSize="32"
										   FontWeight="Bold"
										   Margin="0,8,0,0"/>

							</StackPanel>

						</Border>

						<!-- Status -->
						<Border Grid.Column="2"
								Background="#1B1E24"
								CornerRadius="10"
								Padding="20">

							<StackPanel>

								<TextBlock Text="STATUS"
										   Foreground="#8D929B"
										   FontSize="12"/>

								<TextBlock Text="ONLINE"
										   Foreground="#7ED957"
										   FontSize="24"
										   FontWeight="Bold"
										   Margin="0,8,0,0"/>

							</StackPanel>

						</Border>

					</Grid>

				</StackPanel>

			</Grid>

        </Grid>

    </Grid>

</Window>