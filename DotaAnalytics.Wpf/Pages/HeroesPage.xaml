<UserControl x:Class="DotaAnalytics.Wpf.Pages.HeroesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="#101114" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="🦸 Топ-10 популярных героев" 
                       Foreground="White" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="StatusText" 
                       Text="Загрузка данных..." 
                       Foreground="#A0A3AA" 
                       FontSize="14" 
                       VerticalAlignment="Center" 
                       Margin="20,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="HeroesDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#181A1F"
                  Foreground="White"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#2A2D35"
                  BorderThickness="0"
                  RowBackground="#181A1F"
                  AlternatingRowBackground="#1B1E24">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#252830"/>
                    <Setter Property="Foreground" Value="#A0A3AA"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Место" Binding="{Binding Rank}" Width="0.8*" />
                <DataGridTextColumn Header="Hero ID" Binding="{Binding HeroId}" Width="1.5*" />
                <DataGridTextColumn Header="Матчей" Binding="{Binding GamesPlayed}" Width="*" />
                <DataGridTextColumn Header="Побед" Binding="{Binding Wins}" Width="*" />
                <DataGridTextColumn Header="Поражений" Binding="{Binding Losses}" Width="*" />
                <DataGridTextColumn Header="Винрейт" Binding="{Binding WinRate, StringFormat={}{0:F2}%}" Width="1.2*" />
                <DataGridTextColumn Header="Ср. K" Binding="{Binding AverageKills, StringFormat={}{0:F1}}" Width="*" />
                <DataGridTextColumn Header="Ср. D" Binding="{Binding AverageDeaths, StringFormat={}{0:F1}}" Width="*" />
                <DataGridTextColumn Header="Ср. A" Binding="{Binding AverageAssists, StringFormat={}{0:F1}}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>