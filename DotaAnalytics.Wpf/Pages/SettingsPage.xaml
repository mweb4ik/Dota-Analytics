<UserControl x:Class="DotaAnalytics.Wpf.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="#101114" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="⚙️ Настройки" 
                   Foreground="White" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Margin="0,0,0,25"/>

        <!-- Информация о приложении -->
        <Border Grid.Row="1" 
                Background="#181A1F" 
                BorderBrush="#2A2D35" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="25" 
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="О приложении" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>
                <TextBlock Text="Dota Analytics v1.0" 
                           Foreground="White" 
                           FontSize="16" 
                           Margin="0,0,0,8"/>
                <TextBlock Text="Клиент-серверное приложение для анализа матчей Dota 2" 
                           Foreground="#A0A3AA" 
                           FontSize="14" 
                           Margin="0,0,0,8"/>
                <TextBlock Text="API: https://dota-analytics-8hnu.onrender.com" 
                           Foreground="#7ED957" 
                           FontSize="14" 
                           Margin="0,0,0,8"/>
                <TextBlock Text="Источник данных: OpenDota API (api.opendota.com)" 
                           Foreground="#A0A3AA" 
                           FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Управление данными -->
        <Border Grid.Row="2" 
                Background="#181A1F" 
                BorderBrush="#2A2D35" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="25" 
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🗄️ Управление данными" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <TextBlock Text="Используйте эти кнопки для обновления данных из OpenDota API. Рекомендуется сначала очистить базу, затем загрузить свежие данные." 
                           Foreground="#A0A3AA" 
                           FontSize="13" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button x:Name="ClearBtn" 
                            Content="🗑️ Очистить базу данных" 
                            Width="220" 
                            Height="45" 
                            Background="#DC3545" 
                            Foreground="White" 
                            BorderThickness="0" 
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="ClearBtn_Click"/>

                    <Button x:Name="FetchBtn" 
                            Content="📥 Загрузить свежие данные" 
                            Width="240" 
                            Height="45" 
                            Background="#28A745" 
                            Foreground="White" 
                            BorderThickness="0" 
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Margin="15,0,0,0"
                            Click="FetchBtn_Click"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" 
                           Text="✅ Готов к работе" 
                           Foreground="#7ED957" 
                           FontSize="14" 
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Предупреждение -->
        <Border Grid.Row="3" 
                Background="#2A1F1F" 
                BorderBrush="#DC3545" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20">
            <TextBlock Text=" Внимание: Очистка базы удалит ВСЕ матчи и статистику игроков без возможности восстановления. Загрузка свежих данных займёт 30-60 секунд. Во время загрузки не закрывайте приложение." 
                       Foreground="#FFA500" 
                       FontSize="13" 
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>