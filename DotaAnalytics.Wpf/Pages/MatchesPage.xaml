<UserControl x:Class="DotaAnalytics.Wpf.Pages.MatchesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#101114" Margin="20">
        <!-- Разделяем Grid на две части: таблица и панель пагинации -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Таблица занимает всё свободное место -->
            <RowDefinition Height="Auto"/>
            <!-- Панель пагинации внизу -->
        </Grid.RowDefinitions>

        <!-- Таблица данных -->
        <DataGrid x:Name="MatchesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#181A1F"
                  Foreground="White"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#2A2D35"
                  BorderThickness="0"
                  RowBackground="#181A1F"
                  AlternatingRowBackground="#1B1E24">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#252830"/>
                    <Setter Property="Foreground" Value="#A0A3AA"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Match ID" Binding="{Binding MatchId}" Width="2*" />
                <DataGridTextColumn Header="Длительность (сек)" Binding="{Binding Duration}" Width="*" />
                <DataGridTextColumn Header="Победа Radiant" Binding="{Binding RadiantWin}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель пагинации -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="BtnPrev" Content="← Назад" Width="100" Height="35" 
                    Background="#252830" Foreground="White" BorderThickness="0"
                    Click="BtnPrev_Click" Margin="0,0,15,0"/>

            <TextBlock x:Name="PageNumberText" Text="Страница 1 из 1" 
                       Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0"/>

            <Button x:Name="BtnNext" Content="Вперёд →" Width="100" Height="35" 
                    Background="#252830" Foreground="White" BorderThickness="0"
                    Click="BtnNext_Click"/>
        </StackPanel>
    </Grid>
</UserControl>